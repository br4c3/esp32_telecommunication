{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "functions": {
    "source": "apps",
    "runtime": "nodejs22"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Seat Care ESP32",
        "supportEmail": "tommy1005a@gmail.com"
      }
    }
  },
  "hosting": {
    "public": "apps/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/admin{,/**}",
        "destination": "/admin/index.html"
      },
      {
        "source": "/user{,/**}",
        "destination": "/user/index.html"
      },
      {
        "source": "**",
        "destination": "/user/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs|css|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
